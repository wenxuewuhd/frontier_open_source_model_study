{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenxuewuhd/frontier_open_source_model_study/schema/model.schema.json",
  "title": "模型记录",
  "description": "一个模型版本的完整记录。数值字段只写事实，推导值由 scripts/derive.py 填入 derived 块，不手写。",
  "type": "object",
  "required": ["id", "family", "kind", "display_name", "released", "visibility", "evidence"],
  "additionalProperties": false,

  "$defs": {
    "evidence_tag": {
      "description": "证据口径。official=官方披露；derived=由本仓脚本计算；judgement=解释判断；unknown=未知",
      "enum": ["official", "derived", "judgement", "unknown"]
    },
    "visibility": {
      "description": "public 进公开站；internal 只在内部 overlay 构建中出现，公开仓 CI 会拒绝",
      "enum": ["public", "internal"]
    },
    "ref": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["paper", "modelcard", "blog", "repo", "pr", "issue", "doc", "internal", "self-test"] },
        "url": { "type": "string" },
        "locator": { "type": "string", "description": "页码、章节号、文件:锚点，便于复核" },
        "accessed": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "review_finding": {
      "type": "object",
      "description": "一条核查发现。被改掉的和被证伪的都要留痕 —— 后者同样有价值，它能挡住以后重复提同一个质疑",
      "required": ["id", "field", "severity", "finding", "resolution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^R[0-9]+$" },
        "field": {
          "type": "string",
          "description": "被质疑的字段点分路径；整条记录层面的问题写 '-'"
        },
        "severity": {
          "description": "wrong=数值或事实错误；unsupported=找不到依据；imprecise=不算错但会误导；missing=漏了重要字段；stale=已过时；overreach=过度推论；miscategorized=口径标错",
          "enum": ["wrong", "unsupported", "imprecise", "missing", "stale", "overreach", "miscategorized"]
        },
        "claim": { "type": "string", "description": "核查前记录里是怎么说的" },
        "finding": { "type": "string", "description": "核查结论及其依据，要能复核" },
        "resolution": {
          "description": "corrected=已改；refuted=质疑不成立，原值保留；confirmed=原值正确且补了依据；open=确有问题但未解决；deferred=已知但本期不处理",
          "enum": ["corrected", "refuted", "confirmed", "open", "deferred"]
        },
        "changed_to": { "type": "string", "description": "resolution=corrected 时，改成了什么" }
      }
    },

    "dtype": {
      "description": "权重/激活的数据类型记号，沿用 safetensors 与各家量化方案的写法",
      "type": "string",
      "enum": [
        "FP32", "TF32", "BF16", "FP16",
        "FP8_E4M3", "FP8_E5M2", "MXFP8", "HIF8",
        "FP6", "MXFP4", "NVFP4", "FP4", "HIF4",
        "INT8", "INT4", "UINT8",
        "FP8_E8M0", "MIXED"
      ]
    }
  },

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "全仓唯一短 id，小写，用于文件名、URL 和跨表引用"
    },
    "family": {
      "enum": ["deepseek", "glm", "minimax", "kimi", "qwen", "stepfun", "other"]
    },
    "kind": {
      "description": "llm=纯语言；vlm=图文理解；omni=全模态理解；dllm=扩散语言模型；image-gen/video-gen=生成类",
      "enum": ["llm", "vlm", "omni", "dllm", "image-gen", "video-gen"]
    },
    "display_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "released": { "type": "string", "format": "date" },
    "license": { "type": "string" },
    "visibility": { "$ref": "#/$defs/visibility" },

    "sources": {
      "type": "array",
      "description": "本记录依据的全部来源，字段级 evidence 指向这里的下标",
      "items": { "$ref": "#/$defs/ref" }
    },

    "hf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string" },
        "sha": { "type": "string", "description": "取数时的 commit，保证 shapes/config 可复现" },
        "last_modified": { "type": "string" },
        "pipeline_tag": { "type": "string" },
        "gated": { "type": "boolean" }
      }
    },

    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track": { "enum": ["main", "side", "historical"], "description": "主线 / 平行支线 / 历史节点" },
        "predecessor": { "type": "string" },
        "successor": { "type": "string" },
        "changed_from_predecessor": {
          "type": "array",
          "description": "相对前代改了什么，这是家族页时间线的内容来源",
          "items": {
            "type": "object",
            "required": ["axis", "text"],
            "additionalProperties": false,
            "properties": {
              "axis": { "enum": ["attention", "moe", "residual", "retrieval", "precision", "context", "modality", "decoding", "scale", "training"] },
              "text": { "type": "string", "description": "改了什么。要能对照 config 或权重清单复核" },
              "benefit": {
                "type": "string",
                "description": "为什么改：解决了什么问题、换来什么收益、代价是什么。只写公开材料支持得住的，推测归 judgement"
              }
            }
          }
        }
      }
    },

    "params": {
      "type": "object",
      "description": "参数口径。total 按声明形状统计权重元素，MoE 含全部专家；active_* 是每 token 选中的线性权重，不等于计算量",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "number" },
        "active_decode": { "type": "number" },
        "active_prefill": { "type": "number" },
        "breakdown": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "按子系统拆分，如 backbone / retrieval_table / vision / audio / draft"
        },
        "excludes": {
          "type": "array",
          "description": "声明值不含哪些子系统（如 draft）。推导脚本据此扣减后再核对，否则会报出一个口径不同导致的假差异",
          "items": { "enum": ["draft", "vision", "audio", "retrieval", "embed", "expert"] }
        },
        "counting_note": { "type": "string", "description": "是否含 MTP、共享别名、非训练表，必须写明" }
      }
    },

    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "integer" },
        "train_native": { "type": "integer", "description": "原生训练长度，与外推后的上限区分" },
        "compress_ratio": { "type": "number" },
        "extension_method": { "type": "string" }
      }
    },

    "arch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": { "type": "integer" },
        "hidden": { "type": "integer" },
        "vocab": { "type": "integer" },
        "norm": { "type": "string" },
        "norm_eps": { "type": "number", "description": "非常规取值会让图编译器的融合 pass 匹配不上，必须记" },
        "activation": { "type": "string" },
        "position": { "type": "string" },

        "attention": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "混合结构用 hybrid，再在 layer_pattern 里写分布。MQA-latent 指多个 query 头共读一个低秩 latent KV，但发布权重里没有把 latent 升回逐头 K/V 的上投影 —— 与 MLA 同构却不是 MLA，KV 公式按 latent 维算而不是按 2×头数×头维",
              "enum": ["MHA", "GQA", "MQA", "MQA-latent", "MLA", "linear", "sparse", "hybrid"]
            },
            "num_heads": { "type": "integer" },
            "num_kv_heads": { "type": "integer" },
            "head_dim": { "type": "integer" },
            "qk_rope_head_dim": { "type": "integer" },
            "qk_nope_head_dim": { "type": "integer" },
            "kv_lora_rank": { "type": "integer" },
            "q_lora_rank": { "type": "integer" },
            "o_lora_rank": { "type": "integer" },
            "o_groups": { "type": "integer" },
            "sliding_window": { "type": "integer", "description": "局部窗口大小。有滑窗时每层都有自己的窗口 KV，不随上下文增长但常驻" },
            "attn_sink": { "type": "string", "description": "attention sink 的形态。它改变 softmax 的算子签名，漏掉不报错但分布错" },
            "kv_sharing": {
              "type": "object",
              "description": "跨层 KV 共享。只有部分层产出 KV、其余层读取时，按层数乘的 KV 公式会高估一个量级，必须显式给出",
              "additionalProperties": false,
              "properties": {
                "source_layers": { "type": "array", "items": { "type": "integer" }, "description": "真正产出 KV 的层" },
                "compress_ratios": { "type": "array", "items": { "type": "number" }, "description": "逐层压缩比，0 表示该层不建 KV" },
                "index_source_layers": { "type": "array", "items": { "type": "integer" }, "description": "已废弃，改用下面两个 —— 它把产出层和重打分层混在一起，会让 indexer 缓存高估一倍" },
                "index_kv_source_layers": { "type": "array", "items": { "type": "integer" }, "description": "真正产出 index K 的层（有 indexer.wk 权重）。indexer 缓存只按这些层算" },
                "index_rescore_layers": { "type": "array", "items": { "type": "integer" }, "description": "只复用已有 index K 重新打分、不产出 K 的层（有 wq_b/weights_proj 但无 wk）" },
                "note": { "type": "string" }
              }
            },
            "layer_pattern": { "type": "string", "description": "混合注意力的层分布，如 3:1 linear:full" },
            "partial_rotary_factor": { "type": "number", "description": "只对部分维度加 rope 时的比例" },
            "output_gate": {
              "type": "object",
              "description": "注意力输出门控。会多一路投影与逐元素乘，算子表里是独立一行",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "type": { "type": "string" }
              }
            },
            "hybrid": {
              "type": "object",
              "description": "混合注意力的层分布。必须机器可读：full 层的 KV 随上下文增长，线性层只带固定状态，两者增长方式不同，混在一起无法做容量规划",
              "additionalProperties": false,
              "properties": {
                "layer_types_count": {
                  "type": "object",
                  "additionalProperties": { "type": "integer" },
                  "description": "各类型层数，如 {linear: 48, full: 16}"
                },
                "interval": { "type": "integer", "description": "每隔几层一个 full attention" },
                "layer_types": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "逐层类型。config 里有就不必重复写在这里"
                },
                "note": { "type": "string" }
              }
            },
            "sparse": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mechanism": { "type": "string", "description": "如 indexer 选块、滑窗、NSA/MoBA 式" },
                "index_n_heads": { "type": "integer" },
                "index_head_dim": { "type": "integer" },
                "block_size": { "type": "integer" },
                "selected_blocks": { "type": "integer" },
                "index_topk": { "type": "integer" },
                "candidate_source_layer": { "type": "integer" },
                "candidate_topk_blocks": { "type": "integer" },
                "candidate_block_size": { "type": "integer" }
              }
            },
            "linear_state": {
              "type": "object",
              "description": "线性/状态空间注意力的递归状态。它每序列固定、与上下文长度无关，是和 KV cache 完全不同的显存模型",
              "additionalProperties": false,
              "properties": {
                "mechanism": { "type": "string" },
                "state_dim": { "type": "integer" },
                "num_heads": { "type": "integer" },
                "num_key_heads": { "type": "integer" },
                "num_value_heads": { "type": "integer" },
                "key_head_dim": { "type": "integer" },
                "value_head_dim": { "type": "integer" },
                "conv_kernel_dim": { "type": "integer", "description": "短卷积窗长，另带一份小状态" },
                "state_dtype": { "type": "string", "description": "状态常以 FP32 保存，和 KV 精度不同" },
                "state_layout_note": { "type": "string", "description": "状态布局依实现而定；推导脚本按常见布局估算并标注" }
              }
            }
          }
        },

        "ffn": {
          "type": "object",
          "description": "FFN 形态。dense 模型没有 moe 块，中间维度写在这里",
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["dense", "moe", "hybrid"] },
            "intermediate": { "type": "integer" },
            "layer_pattern": { "type": "string", "description": "dense 与 moe 层混排时的分布" }
          }
        },

        "moe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "routed_experts": { "type": "integer" },
            "shared_experts": { "type": "integer" },
            "top_k": { "type": "integer" },
            "intermediate": { "type": "integer" },
            "dense_intermediate": { "type": "integer" },
            "first_k_dense": { "type": "integer" },
            "routing": { "type": "string" },
            "balance": { "type": "string", "description": "aux-loss / aux-loss-free bias 等" },
            "routing_bias": { "type": "string", "description": "路由偏置的套数与用途。多套偏置会改变融合 router 的算子签名" },
            "expert_groups": { "type": "integer" },
            "hash_layers": {
              "type": "object",
              "description": "按 token id 查表选专家、不经打分的层。它和打分路由是两条不同的路径，融合 router 要能走旁路",
              "additionalProperties": false,
              "properties": {
                "count": { "type": "integer" },
                "mapping_tensor": { "type": "string", "description": "承载映射的张量名，如 ffn.gate.tid2eid" },
                "note": { "type": "string" }
              }
            },
            "storage_note": { "type": "string", "description": "专家是逐个独立张量还是堆叠成一个，决定 grouped GEMM 的权重布局与 EP 切分方式" }
          }
        },

        "residual": {
          "type": "object",
          "description": "残差流本身被改造的情况，如 mHC 把残差扩成多份",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string" },
            "multiplier": { "type": "integer" },
            "sinkhorn_iters": { "type": "integer" },
            "eps": { "type": "number", "description": "与主干 norm_eps 是两个不同的 epsilon，别混" },
            "coef_proj": { "type": "string", "description": "混合系数投影的形状与精度，决定 decode 的额外权重搬运" },
            "note": { "type": "string" }
          }
        },

        "retrieval": {
          "type": "object",
          "description": "外置查表/记忆层，如 Engram。它的存储量级和主干不是一个量级，必须单列",
          "additionalProperties": false,
          "properties": {
            "mechanism": { "type": "string" },
            "layers": { "type": "array", "items": { "type": "integer" }, "description": "装在哪几层" },
            "table_rows": { "type": "array", "items": { "type": "number" }, "description": "每张表行数，各表可能不等" },
            "entry_dim": { "type": "integer" },
            "hash_cols": { "type": "integer" },
            "lookup_bytes_per_token": { "type": "number" },
          "projection": { "type": "string", "description": "查表之外的稠密投影。它每 token 全量搬运，和稀疏查表是完全不同的负载，必须分开说" },
            "placement": { "type": "string", "description": "HBM / host UVA / SSD" }
          }
        },

        "decoding": {
          "type": "object",
          "description": "投机解码、MTP 等会改变每步 token 数的机制",
          "additionalProperties": false,
          "properties": {
            "mtp_layers": { "type": "integer" },
            "speculative": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "method": { "type": "string" },
                "num_tokens": { "type": "integer" },
                "accept_rate": { "type": "number" },
                "target_layers": { "type": "array", "items": { "type": "integer" } },
                "own_moe": {
                  "type": "object",
                  "description": "草稿模型自带专家集时单列 —— 它的权重要另算一份，不能并入主干 MoE",
                  "additionalProperties": false,
                  "properties": {
                    "routed_experts": { "type": "integer" },
                    "top_k": { "type": "integer" },
                    "rank": { "type": "integer" }
                  }
                }
              }
            }
          }
        },

        "vision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoder": { "type": "string" },
            "layers": { "type": "integer" },
            "hidden": { "type": "integer" },
            "num_heads": { "type": "integer" },
            "patch_size": { "type": "integer" },
            "downsample_ratio": { "type": "number" },
            "intermediate": { "type": "integer" },
          "spatial_merge_size": { "type": "integer" },
            "temporal_patch_size": { "type": "integer" },
            "out_hidden": { "type": "integer", "description": "投影到主干前的输出维度" },
            "max_image_tokens": { "type": "integer" },
            "params": { "type": "number" },
            "fusion": { "type": "string", "description": "projector 结构与 token 压缩方式" }
          }
        },

        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoder": { "type": "string" },
            "params": { "type": "number" },
            "tokens_per_second": { "type": "number" },
            "fusion": { "type": "string" },
            "output": { "enum": ["understand-only", "tts", "duplex"] }
          }
        }
      }
    },

    "generation": {
      "type": "object",
      "description": "仅生成类模型（image-gen / video-gen）。负载特征和 LLM 差别很大，单列",
      "additionalProperties": false,
      "properties": {
        "backbone": { "type": "string", "description": "DiT / MMDiT / UNet" },
        "text_encoder": { "type": "string" },
        "vae": { "type": "string" },
        "vae_downsample": { "type": "string" },
        "default_steps": { "type": "integer" },
        "distilled_steps": { "type": "integer" },
        "resolutions": { "type": "array", "items": { "type": "string" } },
        "max_frames": { "type": "integer" },
        "max_duration_s": { "type": "number" }
      }
    },

    "precision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "training": { "$ref": "#/$defs/dtype" },
        "weights_release": {
          "type": "array",
          "description": "官方发布的权重精度，可多种",
          "items": { "$ref": "#/$defs/dtype" }
        },
        "kv_cache": { "$ref": "#/$defs/dtype" },
        "kv_cache_scale": { "$ref": "#/$defs/dtype" },
        "quantization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string" },
            "activation_scheme": { "enum": ["static", "dynamic"] },
            "weight_block_size": { "type": "array", "items": { "type": "integer" } },
            "weight_format": {
              "type": "string",
              "description": "量化权重的元素格式（config 的 fmt，如 e4m3）。和 scale_format 是两回事，混用会凭空造出一次格式迁移"
            },
            "scale_format": {
              "type": "string",
              "description": "scale 张量的格式（config 的 scale_fmt，如 ue8m0）。缺省表示未声明，不等于和 weight_format 相同"
            },
            "block_size_note": { "type": "string", "description": "config 的单一 block 取值常常只覆盖部分子系统，实际粒度以权重清单为准" },
            "expert_dtype": { "$ref": "#/$defs/dtype" },
            "packing_note": { "type": "string", "description": "亚字节权重打包进整型容器时说明清楚：numel 是容器数不是参数数" },
            "per_subsystem": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/dtype" },
              "description": "逐子系统的权重精度，键用 data/schema/subsystems.json 里的 key。由 scripts/fetch_dtypes.py 从权重头实测，不要回填 config 声明值 —— 两者经常对不上"
            },
            "per_subsystem_scale": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/dtype" },
              "description": "对应子系统的 scale 张量精度。和权重精度是两个值：V4 的专家权重是 FP4、scale 是 FP8_E8M0，只报一个会让反量化实现猜错"
            },
            "subsystem_method": {
              "type": "string",
              "description": "这组实测值是怎么来的（全量清单 / 抽样读了几个分片）。抽样只能回答精度，不能用于参数量统计"
            }
          }
        },
        "qat": { "type": "boolean", "description": "官方是否做了量化感知训练，决定低位精度能不能直接用" }
      }
    },

    "derived": {
      "type": "object",
      "description": "全部由 scripts/derive.py 生成，evidence 一律 derived。手写内容会被 validate.py 拒绝",
      "additionalProperties": true,
      "properties": {
        "generated_by": { "type": "string" },
        "generated_at": { "type": "string" },
        "inputs": { "type": "object", "description": "取数依据：config 与 shapes 的来源和 sha" }
      }
    },

    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine", "hardware", "status"],
        "additionalProperties": false,
        "properties": {
          "engine": { "type": "string" },
          "engine_version": { "type": "string" },
          "hardware": { "type": "string" },
          "precision": { "$ref": "#/$defs/dtype" },
          "parallel": { "type": "string", "description": "如 TP1/DP4/EP4" },
          "status": {
            "description": "day0=发布同日可用；supported=已支持；partial=部分可用；wip=进行中；none=不支持；unknown=未查",
            "enum": ["day0", "supported", "partial", "wip", "none", "unknown"]
          },
          "since": { "type": "string" },
          "graph_mode": { "type": "string" },
          "caveat": { "type": "string", "description": "代码支持但无文档化配方、CI 未绿之类的限定，必须写" },
          "ref": { "$ref": "#/$defs/ref" },
          "visibility": { "$ref": "#/$defs/visibility" }
        }
      }
    },

    "performance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "hardware", "engine"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["official", "community", "self"] },
              "ref": { "$ref": "#/$defs/ref" }
            }
          },
          "hardware": { "type": "string" },
          "device_count": { "type": "integer" },
          "engine": { "type": "string" },
          "engine_version": { "type": "string" },
          "precision": { "$ref": "#/$defs/dtype" },
          "parallel": { "type": "string" },
          "input_len": { "type": "integer" },
          "output_len": { "type": "integer" },
          "batch": { "type": "integer" },
          "concurrency": { "type": "integer" },
          "throughput_tok_s": { "type": "number" },
          "throughput_per_device": { "type": "number" },
          "ttft_ms": { "type": "number" },
          "tpot_ms": { "type": "number" },
          "visibility": { "$ref": "#/$defs/visibility" }
        }
      }
    },

    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension", "finding"],
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": ["weight-bandwidth", "kv-capacity", "kv-bandwidth", "compute", "ep-comm", "tp-comm", "host-io", "cube-vector-balance", "operator-gap", "long-context", "graph-mode", "other"]
          },
          "finding": { "type": "string" },
          "quantified": { "type": "string", "description": "能量化就量化，并说明是实测还是推导" },
          "fix": { "type": "string", "description": "可修则写怎么修，这是 infra 侧的行动项" },
          "ref": { "$ref": "#/$defs/ref" },
          "visibility": { "$ref": "#/$defs/visibility" }
        }
      }
    },

    "ops_table": {
      "type": "object",
      "description": "算子表只放摘要和指针，表体在 data-private/ops/<id>/，由 mk_ops_table.py 渲染",
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "description": "相对 data-private 的路径" },
        "target_hardware": { "type": "string" },
        "baseline_parallel": { "type": "string" },
        "row_count": { "type": "integer" },
        "existing_ops": { "type": "integer" },
        "new_ops": { "type": "integer" },
        "fusion_groups": { "type": "integer" },
        "visibility": { "$ref": "#/$defs/visibility" }
      }
    },

    "infra_signals": {
      "type": "array",
      "description": "本记录对下一代 infra 的结论，1-3 条。这是全项目的落点",
      "items": {
        "type": "object",
        "required": ["text", "evidence"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence_tag" },
          "horizon": {
            "enum": ["now", "next-gen", "watch", "settled"],
            "description": "now 当代就要做 / next-gen 下一代硬件要考虑 / watch 盯着别投入 / settled 已定型，结论是不需要新动作"
          },
          "axis": { "type": "string" },
          "visibility": { "$ref": "#/$defs/visibility" }
        }
      }
    },

    "evidence": {
      "type": "object",
      "description": "字段级证据口径。键是点分路径，支持前缀继承：arch.* 覆盖整棵子树；更深的路径优先。validate.py 检查每个叶子都有归属",
      "additionalProperties": { "$ref": "#/$defs/evidence_tag" }
    },

    "reviewed": {
      "type": "object",
      "description": "核查元信息。没有这个块说明这份记录还没被核查过 —— 校验会告警而不是报错，以便看清哪些未核查",
      "required": ["date", "method"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string" },
        "method": { "type": "string", "description": "怎么核的，要具体到依据了哪些来源" },
        "scope": {
          "type": "array",
          "description": "核查覆盖了哪些口径类别",
          "items": { "enum": ["official", "derived", "judgement"] }
        },
        "reviewer": { "type": "string" }
      }
    },

    "review": {
      "type": "array",
      "description": "核查发现。resolution=open 的条目必须同时出现在 open_questions 里，否则问题会藏在这里没人看见",
      "items": { "$ref": "#/$defs/review_finding" }
    },

    "notes": { "type": "string" },
    "open_questions": {
      "type": "array",
      "description": "已知未解的问题，明确写出来比留空好",
      "items": { "type": "string" }
    }
  },

  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["image-gen", "video-gen"] } }, "required": ["kind"] },
      "then": { "required": ["generation"] }
    },
    {
      "if": { "properties": { "kind": { "enum": ["vlm", "omni"] } }, "required": ["kind"] },
      "then": { "properties": { "arch": { "required": ["vision"] } } }
    }
  ]
}
