---
import Base from '../layouts/Base.astro';
import Evidence from '../components/Evidence.astro';
import Prose from '../components/Prose.astro';
import {
  allModels, allSignals, familyGroups, roster, timeline, url, fmtCount, fmtBytes,
  FAMILY_LABEL, ROSTER_STATUS_LABEL,
  HORIZON_LABEL, HORIZON_ORDER, KV_BASIS_LABEL,
} from '../lib/data';

const models = allModels();
const lines = familyGroups();
const rosterUpdated = roster().updated;
const signals = allSignals();
const byHorizon = HORIZON_ORDER.map((h) => ({
  key: h,
  label: HORIZON_LABEL[h],
  items: signals.filter((s) => s.horizon === h),
}));
const allEntries = lines.flatMap((g) => g.entries);
// 「已录」按旗舰算。ltx 的旗舰仓 gated 而两份 members 已录 ——
// 按家族算是 12、按旗舰算是 11，所以句子里要写明按哪个。
const recorded = allEntries.filter((f) => f.status === 'recorded').length;
---

<Base
  title="总览"
  lead="从 infra 视角跟踪主流开源大模型与新型范式的演进。每次模型变化都回答三件事：改了什么、对负载意味着什么、下一代 infra 要准备什么。"
>
  <h2>追踪名册</h2>
  <p class="small muted">
    两条线各有一套选题标准，是并列不是替换 —— 语言模型线按「每族追最新旗舰」就够，
    生成线换一次 VAE 就会让下游 token 数差几倍，同代档位也得单独录。
    名册更新于 {rosterUpdated}，旗舰已录 {recorded} / {allEntries.length} 家。
  </p>
  {
    lines.map((g) => (
      <>
        <h3>{g.label}</h3>
        <p class="small muted">{g.policy}</p>
        <table>
          <thead>
            <tr>
              <th>家族</th>
              <th>旗舰</th>
              <th>发布</th>
              <th>状态</th>
              <th>备注</th>
            </tr>
          </thead>
          <tbody>
            {g.entries.flatMap((f) =>
              /* members 也要出行：ltx 的旗舰取不到数，整个 family 看起来像没录，
                 而 ltx-2 / ltx-2.3 就在 members 里录着 */
              [f, ...(f.members ?? [])].map((e, i) => (
                <tr>
                  <td>
                    {i === 0 ? (
                      FAMILY_LABEL[f.family] ?? f.family
                    ) : (
                      <span class="muted small">　└ 同族档位</span>
                    )}
                  </td>
                  <td>
                    {e.model_id ? (
                      <a href={url(`/models/${e.model_id}/`)}>{e.flagship ?? e.model_id}</a>
                    ) : (
                      <span class="muted">{e.flagship ?? e.model_id}</span>
                    )}
                  </td>
                  <td class="num">{e.released ?? '—'}</td>
                  <td>
                    {e.status === 'recorded' ? (
                      ROSTER_STATUS_LABEL[e.status]
                    ) : (
                      <span class="muted">{ROSTER_STATUS_LABEL[e.status] ?? e.status}</span>
                    )}
                  </td>
                  <td class="small muted"><Prose text={e.note ?? ''} /></td>
                </tr>
              )),
            )}
          </tbody>
        </table>
      </>
    ))
  }

  <h2>已录记录</h2>
  <div class="grid c2">
    {
      models.map((m) => {
        const s = m.derived?.from_shapes;
        const kv = m.derived?.kv_cache;
        return (
          <div class="card">
            <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
              <a href={url(`/models/${m.id}/`)} style="font-weight:650;font-size:15px">
                {m.display_name}
              </a>
              <span class="small muted">{FAMILY_LABEL[m.family] ?? m.family}</span>
              {m.lineage?.track === 'side' && <span class="small muted">· 支线档位</span>}
            </div>
            <dl class="kv small" style="margin-top:8px">
              <dt>总参数</dt>
              <dd class="num">
                {s?.complete ? fmtCount(s.params_total) : '—'}
                <Evidence tag="derived" />
              </dd>
              <dt>权重存储</dt>
              <dd class="num">{s?.complete ? fmtBytes(s.weight_bytes_total) : '—'}</dd>
              <dt>注意力显存</dt>
              <dd class="num">
                {kv?.per_token_bytes ? `${kv.per_token_bytes.toLocaleString()} B/token` : '—'}
                {kv?.per_sequence_bytes ? ` + ${fmtBytes(kv.per_sequence_bytes)}/序列` : ''}
                {/* 查表，不逐个值写 if：以前只认 theoretical_floor 与 dtype_fallback，
                    vendor_declared / declared_dtype / mixed 三个值的卡片就一个标签都不出，
                    于是「照抄厂商」和「本仓逐分量算的」在卡上长得一样 */}
                {kv?.bytes_basis && KV_BASIS_LABEL[kv.bytes_basis] && (
                  <span class="muted">（{KV_BASIS_LABEL[kv.bytes_basis]}）</span>
                )}
              </dd>
              {/* 字节口径各卡不一，跨卡比结构要看元素数 —— 它与精度假设无关。
                  单位写进值里：这一行紧挨着上面的「B/token」，只写「1,600 /token」
                  读起来就是同一种量的两个数，而它们差一个「每元素字节」的因子 */}
              <dt>KV 元素</dt>
              <dd class="num">
                {kv?.per_token_elems
                  ? `${kv.per_token_elems_bound === 'upper_bound' ? '≤ ' : ''}${kv.per_token_elems.toLocaleString()} 元素/token`
                  : '—'}
              </dd>
            </dl>
          </div>
        );
      })
    }
  </div>

  <h2>Infra 信号</h2>
  <p class="small muted">
    每条都是对下一代 infra 的结论，按时间窗分组。信号全部是解释判断，需人工复核。
  </p>
  {
    byHorizon
      .filter((g) => g.items.length > 0)
      .map((g) => (
        <>
          <h3>{g.label} · {g.items.length} 条</h3>
          <div class="grid">
            {g.items.map((s) => (
              <div class="card">
                <div class="small muted" style="margin-bottom:4px">
                  <a href={url(`/models/${s.model.id}/`)}>{s.model.display_name}</a>
                  {s.axis && <span> · {s.axis}</span>}
                  <Evidence tag={s.evidence} />
                </div>
                <div><Prose text={s.text} /></div>
              </div>
            ))}
          </div>
        </>
      ))
  }

  <h2>时间线</h2>
  <table>
    <thead>
      <tr>
        <th>发布</th>
        <th>模型</th>
        <th>相对前代的变化</th>
      </tr>
    </thead>
    <tbody>
      {
        timeline().map((m) => (
          <tr>
            <td class="num">{m.released}</td>
            <td><a href={url(`/models/${m.id}/`)}>{m.display_name}</a></td>
            <td class="small">
              {(m.lineage?.changed_from_predecessor ?? []).length > 0 ? (
                <ul class="plain">
                  {m.lineage.changed_from_predecessor.map((c: any) => (
                    <li><span class="muted">{c.axis}</span> — <Prose text={c.text} /></li>
                  ))}
                </ul>
              ) : (
                <span class="muted">未记录</span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Base>
