---
import Base from '../../layouts/Base.astro';
import { familyGroups, url, reviewStatus } from '../../lib/data';

const groups = familyGroups();
---

<Base
  title="家族演进"
  lead="每个家族一页，把各维度的逐版本变化排在一起看。矩阵内容来自各记录的 lineage 字段。"
>
  {
    groups.map((g) => (
      <section style="margin-bottom:26px">
        <h2>{g.label}</h2>
        {/* 两条线的选题标准不同，所以 policy 跟着各自那张表走 ——
            合在一处只能写一句，而那一句对另一条线是错的 */}
        {g.policy && <p class="small muted">{g.policy}</p>}
        <table>
          <thead>
            <tr>
              <th>家族</th>
              <th class="num">已录版本</th>
              <th class="num">已核查</th>
              <th>时间跨度</th>
              <th>最新</th>
            </tr>
          </thead>
          <tbody>
            {g.families.map((f) => {
              const dates = f.models.map((m) => m.released).filter(Boolean).sort();
              const latest = f.models[0];
              return (
                <tr>
                  <td><a href={url(`/families/${f.key}/`)}>{f.label}</a></td>
                  <td class="num">{f.models.length}</td>
                  <td class="num">{f.models.filter((m) => reviewStatus(m).reviewed).length}</td>
                  <td class="num small">
                    {dates.length ? `${dates[0]} → ${dates[dates.length - 1]}` : '—'}
                  </td>
                  <td><a href={url(`/models/${latest.id}/`)}>{latest.display_name}</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {g.pending.length > 0 && (
          <p class="note" style="margin-top:14px">
            这条线上名册里还没录的家族：{g.pending.map((f) => f.flagship ?? f.family).join('、')}。
            旗舰选取结果见<a href={url('/')}>总览</a>的追踪名册。
          </p>
        )}
      </section>
    ))
  }
</Base>
