---
/**
 * 家族页：一个家族在各维度上的逐版本演进。
 *
 * 四块内容，都从记录里算出来，页面不自带任何表：
 *   1. 变化矩阵   维度 × 版本，格子里是「字段：旧值 → 新值」。由 changesFor 逐字段比出来，
 *                 不经过任何人写的文字，所以不会和记录漂移
 *   2. 逐维度演进 每个维度按版本顺序读下来：改了什么（text）+ 为什么改（benefit）
 *   3. 规格对照   各版本的关键规格
 *   4. 精度对照   量化是独立于规格的一条演进线，混在规格表里看不出节奏，所以单拉一张
 *
 * 为什么不手写矩阵：手写表会和记录各自漂移，而记录才是 validate.py 覆盖的那份。
 */
import Base from '../../layouts/Base.astro';
import Evidence from '../../components/Evidence.astro';
import {
  familyModels, axisMatrix, changeMatrix, allModels, url, fmtSci,
  TRACKED_FIELDS, SUBSYSTEM_FIELD_PREFIX, FAMILY_LABEL, FAMILY_ORDER,
  HORIZON_LABEL, reviewStatus,
} from '../../lib/data';

export function getStaticPaths() {
  const fams = new Set(allModels().map((m) => m.family));
  return FAMILY_ORDER.filter((f) => fams.has(f)).map((family) => ({ params: { family } }));
}

const { family } = Astro.params;
const label = FAMILY_LABEL[family!] ?? family!;
const models = familyModels(family!);
const narrative = axisMatrix(models);
const matrix = changeMatrix(models);

/** 表头用短名。家族前缀对每一列都一样，占着宽度不提供信息。 */
const short = (m: any) =>
  m.display_name.replace(new RegExp(`^${label}[-_ ]?`, 'i'), '') || m.display_name;

const specFields = TRACKED_FIELDS.filter((f) => f.group === 'spec');
const precFields = TRACKED_FIELDS.filter((f) => f.group === 'precision');
const visible = (fs: typeof TRACKED_FIELDS) =>
  fs.filter((f) => models.some((m) => f.get(m) !== undefined));
const visiblePrec = visible(precFields);
/** 分组行插在第一条实测行之前，把 config 声明和实测分开 */
const firstMeasured = visiblePrec.findIndex((f) => f.key.startsWith(SUBSYSTEM_FIELD_PREFIX));

const signals = models.flatMap((m) =>
  (m.infra_signals ?? []).map((s: any) => ({ ...s, model: m })),
);
const reviewed = models.filter((m) => reviewStatus(m).reviewed).length;
const sideCls = (m: any) => (m.lineage?.track === 'side' ? 'side' : undefined);
---

<Base
  title={`${label} 谱系`}
  lead={`${models.length} 个版本，按发布顺序。矩阵逐字段比出来，叙述来自各记录的 lineage 字段，都不另存一份表。`}
>
  <p class="small muted">
    已核查 {reviewed} / {models.length} 份记录。规格与精度取自 config（官方口径）；
    变化矩阵是两份记录的字段差（计算推导）；「为什么改」是解释判断。
  </p>

  <h2>变化矩阵 <Evidence tag="derived" /></h2>
  <p class="small muted">
    每格是「字段：旧值 → 新值」，和前代（<code>lineage.predecessor</code>）比，不是和时间上的前一个比 ——
    支线的前代不是时间前一个。只列出有字段变化的版本。
  </p>
  <div class="scroll-x">
    <table class="matrix">
      <thead>
        <tr>
          <th>维度</th>
          {matrix.cols.map((m) => (
            <th class={sideCls(m)} title={m.display_name}>
              <a href={url(`/models/${m.id}/`)}>{short(m)}</a>
              {m.lineage?.track === 'side' && <span class="track-mark" title="支线">支</span>}
              <div class="small muted" style="font-weight:400">{m.released}</div>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {matrix.rows.map((r) => (
          <tr>
            <td>{r.label}</td>
            {r.cells.map((c) => (
              <td class={sideCls(c.model)}>
                {c.changes.length === 0 ? (
                  <span class="dash">·</span>
                ) : (
                  c.changes.map((ch) => (
                    <div class="chg">
                      <span class="muted">{ch.field.label}</span>{' '}
                      <span class="from">{ch.from ?? '无'}</span>
                      <span class="arrow"> → </span>
                      <span class="to">{ch.to ?? '取消'}</span>
                    </div>
                  ))
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {
    matrix.unchanged.length > 0 && (
      <p class="note" style="margin-top:12px">
        字段零变化的版本（{matrix.unchanged.length} 个）：
        {matrix.unchanged.map((m, i) => (
          <>
            {i > 0 && '、'}
            <a href={url(`/models/${m.id}/`)}>{short(m)}</a>
          </>
        ))}
        。这些版本相对前代连一个规格字段都没动，能力变化来自后训练或权重刷新，
        算子清单可直接沿用前代 —— 跟踪时先比张量名集合，相同就不必重走算子评估。
      </p>
    )
  }

  <h2>逐维度演进</h2>
  <p class="small muted">
    「改了什么」要能对照 config 或权重清单复核；「为什么改」是从公开材料与结构本身读出来的判断。
  </p>
  {
    narrative.map((r) => (
      <>
        <h3>{r.label}</h3>
        <table>
          <tbody>
            {r.cells
              .filter((c) => c.entries.length > 0)
              .map((c) => (
                <tr>
                  <td style="width:140px">
                    <a href={url(`/models/${c.model.id}/`)}>{short(c.model)}</a>
                    <div class="small muted">{c.model.released}</div>
                  </td>
                  <td>
                    {c.entries.map((e: any) => (
                      <div class="evo">
                        <div>{e.text} <Evidence tag="derived" /></div>
                        {e.benefit && (
                          <div class="benefit">
                            <span class="muted">收益 ·</span> {e.benefit}
                            <Evidence tag="judgement" />
                          </div>
                        )}
                      </div>
                    ))}
                  </td>
                </tr>
              ))}
          </tbody>
        </table>
      </>
    ))
  }

  <h2>规格对照 <Evidence tag="official" /></h2>
  <p class="small muted">
    空白表示该版本没有这一项（不是缺数据）。参数量不在这里 ——
    只有取过完整权重清单（含 dtype）的版本才报总量，见各记录的「参数量口径」。
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>规格</th>
          {models.map((m) => (
            <th class={sideCls(m)}>
              <a href={url(`/models/${m.id}/`)}>{short(m)}</a>
              {m.lineage?.track === 'side' && <span class="track-mark" title="支线">支</span>}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {visible(specFields).map((f) => (
          <tr>
            <td>{f.label}</td>
            {models.map((m) => {
              const v = f.get(m);
              return <td class={sideCls(m)}>{v === undefined ? <span class="dash">—</span> : v}</td>;
            })}
          </tr>
        ))}
        <tr>
          <td>norm_eps</td>
          {models.map((m) => (
            <td class={sideCls(m)}>{fmtSci(m.arch?.norm_eps) ?? <span class="dash">—</span>}</td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>

  <h2>精度对照 <Evidence tag="official" /></h2>
  <p class="small muted">
    上半部分只留 <strong>dtype 看不出来的</strong> config 声明项。整体量化方法、权重元素格式、
    单独声明的专家精度三项已被下面的实测行覆盖，留着是同一件事说两遍。
    <code>scale 格式</code>留着是因为它和实测<strong>不一致</strong>，而那个不一致正是要说的事。
  </p>
  <p class="small muted">
    下半部分是逐子系统的<strong>实测</strong>精度，由 <code>scripts/fetch_dtypes.py</code>
    直接读权重头得出，不回填 config 声明值。权重精度与 scale 精度分开列 ——
    FP4 权重配 FP8_E8M0 的 scale，只看一个会让反量化实现猜错 scale 张量的大小。
    这些行也进变化矩阵，但只在相邻两版都测过时才比：缺值是「没测」不是「取消」。
  </p>
  <p class="small muted">
    <strong>「激活量化 dynamic」不是精度信息，是算子图信息。</strong>
    它说的是激活的 scale 在运行时现算（而不是离线校准成常量），因此每个量化 GEMM 前面
    都要有一个带归约的量化算子 —— 换成 <code>static</code> 这个算子就不存在了。
    这件事从 dtype 上看不出来，所以它和下面的实测行不重复。
    细节与「反量化为什么不在 epilogue」见<a href={url('/about/')}>口径说明</a>。
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th>精度</th>
          {models.map((m) => (
            <th class={sideCls(m)}>
              <a href={url(`/models/${m.id}/`)}>{short(m)}</a>
              {m.lineage?.track === 'side' && <span class="track-mark" title="支线">支</span>}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {visiblePrec.map((f, i) => (
          <>
            {i === firstMeasured && (
              <tr class="group">
                <td colspan={models.length + 1}>
                  逐子系统实测（权重精度 <span class="muted">/ scale 精度</span>）
                </td>
              </tr>
            )}
            <tr>
              <td>{f.label.replace('（实测）', '')}</td>
              {models.map((m) => {
                const v = f.get(m);
                return (
                  <td class={sideCls(m)}>
                    {v === undefined ? <span class="dash">—</span> : v}
                  </td>
                );
              })}
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>
  {
    models.some((m) => m.precision?.quantization?.block_size_note) && (
      <p class="note" style="margin-top:10px">
        {models
          .filter((m) => m.precision?.quantization?.block_size_note)
          .map((m) => (
            <>
              <strong>{short(m)}</strong>：{m.precision!.quantization.block_size_note}
            </>
          ))}
      </p>
    )
  }

  {
    signals.length > 0 && (
      <>
        <h2>Infra 信号</h2>
        <div class="grid c2">
          {signals.map((s) => (
            <div class="card">
              <div class="small muted" style="margin-bottom:4px">
                {HORIZON_LABEL[s.horizon] ?? s.horizon}
                {s.axis && ` · ${s.axis}`}
                <Evidence tag={s.evidence} />
              </div>
              <div>{s.text}</div>
              <div class="small muted" style="margin-top:6px">
                <a href={url(`/models/${s.model.id}/`)}>{short(s.model)}</a>
              </div>
            </div>
          ))}
        </div>
      </>
    )
  }
</Base>

<style>
  /* 变化矩阵的格子里是多行「旧 → 新」，不能按普通表格那样不换行 */
  .matrix td,
  .matrix th {
    white-space: normal;
    min-width: 168px;
    max-width: 230px;
  }
  .matrix td:first-child,
  .matrix th:first-child {
    min-width: 76px;
    white-space: nowrap;
  }
  .chg {
    font-size: 12.5px;
    line-height: 1.5;
    padding: 2px 0;
  }
  .chg + .chg {
    border-top: 1px dashed var(--line);
  }
  .from {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-color: var(--ink-3);
  }
  .arrow {
    color: var(--ink-3);
  }
  .to {
    color: var(--ink);
    font-weight: 600;
  }
  .evo + .evo {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed var(--line);
  }
  tr.group td {
    background: color-mix(in oklab, var(--warn-bg) 30%, var(--surface));
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    position: static;
  }
  .benefit {
    font-size: 13px;
    color: var(--ink-2);
    margin-top: 3px;
    padding-left: 10px;
    border-left: 2px solid var(--line);
  }
</style>
