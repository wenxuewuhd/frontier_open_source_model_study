                  </tr>
                ) : (
                  <tr>
                    <td>EP all-to-all</td>
                    <td class="num muted">{d?.ep_communication?.why ?? '—'}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </>
    ) : (
      <div class="note">注意力显存未能推导：{kv?.why ?? '缺少必要字段'}</div>
    )
  }

  {act?.note && <p class="small muted" style="margin-top:10px"><Prose text={act.note} /></p>}
  {act?.semantics && <p class="small muted">{act.semantics}</p>}

  {/* 厂商公布的实测性能。**此前整块没有渲染** —— 公开仓里一直没有合格的数据
      （自测性能按 CLAUDE.md 只进 data-private/），直到视频线的两份厂商材料进来。
