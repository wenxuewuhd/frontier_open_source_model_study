                {d?.arithmetic_intensity?.decode_flops_per_byte && (
                  <tr>
                    <td>算术强度（decode）</td>
                    <td class="num">
                      {d.arithmetic_intensity.decode_flops_per_byte.toFixed(2)} FLOP/B
                    </td>
