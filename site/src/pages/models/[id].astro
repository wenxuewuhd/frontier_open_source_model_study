---
import Base from '../../layouts/Base.astro';
import Evidence from '../../components/Evidence.astro';
import Facts from '../../components/Facts.astro';
import AttentionFigure from '../../components/AttentionFigure.astro';
import LayerMap from '../../components/LayerMap.astro';
import Prose from '../../components/Prose.astro';
import {
  allModels, modelById, url, fmtCount, fmtBytes, fmtInt, fmtSci, FAMILY_LABEL,
  reviewStatus, SEVERITY_LABEL, RESOLUTION_LABEL, HORIZON_LABEL, SUBSYSTEMS,
  kvCachePrecision, KV_BASIS_LABEL, evidenceFor,
  officialVariants, ORIGIN_LABEL, STRATEGY_LABEL,
} from '../../lib/data';

const SUBSYSTEM_LABEL: Record<string, string> = Object.fromEntries(
  SUBSYSTEMS.map((s) => [s.key, s.label]),
);

export function getStaticPaths() {
  return allModels().map((m) => ({ params: { id: m.id } }));
}

const { id } = Astro.params;
const m = modelById(id!)!;
const ev = m.evidence;
const d = m.derived ?? null;
const s = d?.from_shapes;
const kv = d?.kv_cache;
const kvPrec = kvCachePrecision(m);
// 生成类记录（扩散 DiT）与自回归模型的负载轴没有交集：没有 KV cache、
// 没有 prefill/decode 之分、没有「每 token」这个单位。有的是
// 「序列长度 × 步数 × 每步前向次数」。所以这两节要分开渲染，
// 否则生成类页面上会出现一排空的 KV 行，而真正算出来的 latent token 数
// 与单步 FLOPs 一个字都看不到（derive.py 一直在算，只是没人读）。
const isGen = m.kind === 'video-gen' || m.kind === 'image-gen';
const gw = d?.generation_workload;
// FLOPs 用三位有效数字。不改共享的 fmtSci —— 它还给 norm_eps 那类用，那边要全精度
const fl = (n: unknown) => (typeof n === 'number' && isFinite(n) ? n.toExponential(3) : '—');
// 字节口径跟着数走：下限、兜底、声明精度是三种数，页面上丢了标签读者会直接当部署预算。
// 标签表只此一份，在 lib/data.ts —— 这里原先另有一份，措辞还不一样
// （「按厂商公布值」vs「厂商公布」），同一个取值在站内有两种读法
const kvBasis = KV_BASIS_LABEL[kv?.bytes_basis] ?? '';
const act = d?.active_params;
const rec: any[] = d?.reconciliation ?? [];
const mismatches = rec.filter((r) => r.status === 'MISMATCH');

const a = m.arch?.attention ?? {};
const moe = m.arch?.moe ?? {};
const ret = m.arch?.retrieval ?? {};
const q = m.precision?.quantization ?? {};

const subsystems = s?.weight_bytes_by_subsystem
  ? Object.entries(s.weight_bytes_by_subsystem as Record<string, number>)
      .sort((x, y) => y[1] - x[1])
  : [];
/** 打包存放的精度 -> 容器类型。表上两个值要一起出现：
    只报 FP4 会让人以为能按 4 位寻址，只报 INT8 会让人以为专家是 8 位 */
const dtypeContainers: Record<string, string[]> = s?.weight_dtype_containers ?? {};
const dtypeRows = s?.weight_bytes_by_dtype
  ? Object.entries(s.weight_bytes_by_dtype as Record<string, number>)
      .sort((x, y) => y[1] - x[1])
  : [];
const capacity = d?.kv_capacity_bytes_at_context
  ? Object.entries(d.kv_capacity_bytes_at_context as Record<string, number>)
      .sort((x, y) => Number(x[0]) - Number(y[0]))
  : [];
const compRatios: number[] | undefined = a.kv_sharing?.compress_ratios;
const rv = reviewStatus(m);
---

<Base
  title={m.display_name}
  lead={`${FAMILY_LABEL[m.family] ?? m.family} · ${m.kind}${
    m.lineage?.track === 'side' ? ' · 支线档位' : ''
  }`}
>
  {
    mismatches.length > 0 && (
      <div class="note" style="margin-bottom:18px">
        <strong>交叉核对有 {mismatches.length} 处不一致</strong>
        ，见下方「交叉核对」一节。在弄清差异根因之前，本页的推导值不宜直接采信。
      </div>
    )
  }

  <h2>基本信息</h2>
  <div class="grid c2">
    <div class="card">
      <Facts
        evidence={ev}
        rows={[
          { label: '发布', value: m.released, path: 'released', mono: true },
          { label: 'License', value: m.license, path: 'license' },
          { label: 'HF 仓库', value: m.hf?.repo, path: 'hf' },
          { label: '取数 commit', value: m.hf?.sha?.slice(0, 12), path: 'hf', mono: true },
        ]}
      />
    </div>
    <div class="card">
      <Facts
        evidence={ev}
        rows={[
          { label: '上下文上限', value: fmtInt(m.context?.max), path: 'context', mono: true },
          { label: '原生训练长度', value: fmtInt(m.context?.train_native), path: 'context', mono: true },
          { label: '外推方式', value: m.context?.extension_method, path: 'context' },
        ]}
      />
    </div>
  </div>

  <h2>规模与存储</h2>
  <div class="grid c3">
    <div class="card stat">
      <div class="label">总参数 · 声明</div>
      <div class="value">
        {fmtCount(m.params?.total)}
        <Evidence tag={m.params?.total !== undefined ? 'official' : undefined} hideUnknown />
      </div>
      <div class="sub">
        {m.params?.excludes?.length ? `不含 ${m.params.excludes.join('、')}` : ''}
      </div>
    </div>
    <div class="card stat">
      <div class="label">总参数 · 实测</div>
      <div class="value">
        {s?.complete ? fmtCount(s.params_total) : '—'}
        <Evidence tag="derived" />
      </div>
      <div class="sub">
        {s ? `${fmtInt(s.tensor_count)} 个张量` : '无权重清单'}
        {s?.expert_storage ? ` · 专家 ${s.expert_storage}` : ''}
      </div>
    </div>
    <div class="card stat">
      <div class="label">权重存储</div>
      <div class="value">{s?.complete ? fmtBytes(s.weight_bytes_total) : '—'}</div>
      <div class="sub">含量化 scale</div>
    </div>
  </div>

  {
    s && !s.complete && (
      <div class="note" style="margin-top:12px"><Prose text={s.incomplete_note} /></div>
    )
  }
  {
    m.params?.counting_note && (
      <p class="small muted" style="margin-top:10px">
        <strong>口径</strong>
        <Evidence tag="judgement" />：<Prose text={m.params.counting_note} />
      </p>
    )
  }

  {
    subsystems.length > 0 && (
      <div class="grid c2" style="margin-top:14px">
        <div>
          <h3>按子系统</h3>
          <table>
            <thead><tr><th>子系统</th><th class="num">参数</th><th class="num">存储</th></tr></thead>
            <tbody>
              {subsystems.map(([k, v]) => (
                <tr>
                  <td>{k}</td>
                  <td class="num">{fmtCount(s.params_by_subsystem?.[k])}</td>
                  <td class="num">{fmtBytes(v)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div>
          <h3>按精度</h3>
          <table>
            <thead><tr><th>数据类型</th><th class="num">存储</th></tr></thead>
            <tbody>
              {dtypeRows.map(([k, v]) => (
                <tr>
                  <td class="num">
                    {k}
                    {dtypeContainers[k] && (
                      <span class="small muted">（{dtypeContainers[k].join('/')} 容器）</span>
                    )}
                  </td>
                  <td class="num">{fmtBytes(v)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {s.packing_applied && Object.keys(s.packing_applied).length > 0 && (
            <p class="small muted">
              已按打包因子还原参数量：
              {Object.entries(s.packing_applied).map(([k, v]) => `${k} ×${v}`).join('、')}。
              存储不还原 —— 容器就是真实存储，但按逻辑精度归类：
              FP4 那一行是 FP4 数据装在 INT8 容器里，不是 8 位权重。
            </p>
          )}
        </div>
      </div>
    )
  }

  <h2>架构</h2>
  <div class="grid c2">
    <div class="card">
      <h3 style="margin-top:0">主干</h3>
      <Facts
        evidence={ev}
        rows={[
          { label: '层数', value: m.arch?.layers, path: 'arch.layers', mono: true },
          { label: 'hidden', value: m.arch?.hidden, path: 'arch.hidden', mono: true },
          { label: '词表', value: fmtInt(m.arch?.vocab), path: 'arch.vocab', mono: true },
          { label: 'norm', value: m.arch?.norm, path: 'arch.norm' },
          { label: 'norm_eps', value: fmtSci(m.arch?.norm_eps), path: 'arch.norm_eps', mono: true },
          { label: '激活函数', value: m.arch?.activation, path: 'arch.activation' },
          { label: '位置编码', value: m.arch?.position, path: 'arch.position' },
        ]}
      />
    </div>
    <div class="card">
      <h3 style="margin-top:0">注意力</h3>
      <Facts
        evidence={ev}
        rows={[
          { label: '类型', value: a.type, path: 'arch.attention.type' },
          { label: '层分布', value: a.layer_pattern, path: 'arch.attention.layer_pattern' },
          { label: 'heads', value: a.num_heads, path: 'arch.attention.num_heads', mono: true },
          { label: 'KV heads', value: a.num_kv_heads, path: 'arch.attention.num_kv_heads', mono: true },
          { label: 'head_dim', value: a.head_dim, path: 'arch.attention.head_dim', mono: true },
          { label: 'kv_lora_rank', value: a.kv_lora_rank, path: 'arch.attention.kv_lora_rank', mono: true },
          { label: 'q_lora_rank', value: a.q_lora_rank, path: 'arch.attention.q_lora_rank', mono: true },
          { label: 'rope 部分比例', value: a.partial_rotary_factor, path: 'arch.attention.partial_rotary_factor', mono: true },
          { label: '输出门控', value: a.output_gate?.enabled ? a.output_gate.type : undefined, path: 'arch.attention.output_gate' },
        ]}
      />
    </div>
  </div>

  {
    (a.hybrid || a.linear_state) && (
      <div class="grid c2" style="margin-top:12px">
        {a.hybrid && (
          <div class="card">
            <h3 style="margin-top:0">混合层分布</h3>
            <Facts
              evidence={ev}
              rows={[
                { label: 'full attention 层', value: a.hybrid.layer_types_count?.full, path: 'arch.attention.hybrid.layer_types_count', mono: true },
                { label: '线性注意力层', value: a.hybrid.layer_types_count?.linear, path: 'arch.attention.hybrid.layer_types_count', mono: true },
                { label: '间隔', value: a.hybrid.interval, path: 'arch.attention.hybrid', mono: true },
              ]}
            />
            {a.hybrid.note && (
              <p class="small muted"><Prose text={a.hybrid.note} /><Evidence tag="judgement" /></p>
            )}
          </div>
        )}
        {a.linear_state && (
          <div class="card">
            <h3 style="margin-top:0">线性状态</h3>
            <Facts
              evidence={ev}
              rows={[
                { label: '机制', value: a.linear_state.mechanism, path: 'arch.attention.linear_state.mechanism' },
                { label: 'key / value 头数', value: `${a.linear_state.num_key_heads ?? '—'} / ${a.linear_state.num_value_heads ?? '—'}`, path: 'arch.attention.linear_state', mono: true },
                { label: 'key / value 头维', value: `${a.linear_state.key_head_dim ?? '—'} / ${a.linear_state.value_head_dim ?? '—'}`, path: 'arch.attention.linear_state', mono: true },
                { label: '卷积窗', value: a.linear_state.conv_kernel_dim, path: 'arch.attention.linear_state', mono: true },
                { label: '状态精度', value: a.linear_state.state_dtype, path: 'arch.attention.linear_state', mono: true },
              ]}
            />
            {a.linear_state.state_layout_note && (
              <p class="small muted"><Prose text={a.linear_state.state_layout_note} /></p>
            )}
          </div>
        )}
      </div>
    )
  }

  {
    (a.kv_sharing || a.sparse) && (
      <div class="grid c2" style="margin-top:12px">
        {a.kv_sharing && (
          <div class="card">
            <h3 style="margin-top:0">跨层 KV 共享</h3>
            <Facts
              evidence={ev}
              rows={[
                { label: 'KV 产出层', value: a.kv_sharing.source_layers, path: 'arch.attention.kv_sharing', mono: true },
                { label: 'indexer 产出层', value: a.kv_sharing.index_source_layers, path: 'arch.attention.kv_sharing', mono: true },
                {
                  label: '逐层压缩比',
                  value: compRatios
                    ? `${compRatios.length} 项，取值 ${[...new Set(compRatios)].sort().join('/')}`
                    : undefined,
                  path: 'arch.attention.kv_sharing',
                },
              ]}
            />
            {a.kv_sharing.note && (
              <p class="small muted"><Prose text={a.kv_sharing.note} /><Evidence tag="derived" /></p>
            )}
          </div>
        )}
        {a.sparse && (
          <div class="card">
            <h3 style="margin-top:0">稀疏注意力</h3>
            <Facts
              evidence={ev}
              rows={[
                { label: '机制', value: a.sparse.mechanism, path: 'arch.attention.sparse.mechanism' },
                { label: 'index heads × dim', value: `${a.sparse.index_n_heads ?? '—'} × ${a.sparse.index_head_dim ?? '—'}`, path: 'arch.attention.sparse', mono: true },
                { label: 'index topk', value: a.sparse.index_topk, path: 'arch.attention.sparse', mono: true },
                { label: '候选块', value: a.sparse.candidate_topk_blocks, path: 'arch.attention.sparse', mono: true },
                { label: '块大小', value: a.sparse.candidate_block_size, path: 'arch.attention.sparse', mono: true },
              ]}
            />
          </div>
        )}
      </div>
    )
  }

  <div class="grid c2" style="margin-top:12px">
    <div class="card">
      <h3 style="margin-top:0">FFN</h3>
      <Facts
        evidence={ev}
        rows={[
          { label: '形态', value: m.arch?.ffn?.type ?? (moe.routed_experts ? 'moe' : undefined), path: 'arch.ffn.type' },
          { label: '中间维', value: m.arch?.ffn?.intermediate, path: 'arch.ffn', mono: true },
          { label: '路由专家', value: moe.routed_experts, path: 'arch.moe.routed_experts', mono: true },
          { label: '共享专家', value: moe.shared_experts, path: 'arch.moe.shared_experts', mono: true },
          { label: 'top_k', value: moe.top_k, path: 'arch.moe.top_k', mono: true },
          { label: '专家中间维', value: moe.intermediate, path: 'arch.moe.intermediate', mono: true },
          { label: '选路', value: moe.routing, path: 'arch.moe.routing' },
          { label: '均衡', value: moe.balance, path: 'arch.moe.balance' },
        ]}
      />
      {moe.storage_note && <p class="small muted"><Prose text={moe.storage_note} /><Evidence tag="derived" /></p>}
    </div>

    {
      (m.arch?.residual || ret.mechanism || m.arch?.decoding) && (
        <div class="card">
          <h3 style="margin-top:0">其他机制</h3>
          <Facts
            evidence={ev}
            rows={[
              { label: '残差流', value: m.arch?.residual
                  // multiplier 同样是选填的（MiniMax 的固定系数残差、Kimi-K3 的 AttnRes
                  // 都只有 type），无条件拼会印出字面量 undefined
                  ? [m.arch.residual.type, m.arch.residual.multiplier]
                      .filter((x) => x !== undefined && x !== null).join(' ×')
                  : undefined, path: 'arch.residual' },
              { label: '外置查表', value: ret.mechanism, path: 'arch.retrieval.mechanism' },
              { label: '表所在层', value: ret.layers, path: 'arch.retrieval.layers', mono: true },
              { label: '表行数', value: ret.table_rows?.map(fmtCount), path: 'arch.retrieval.table_rows', mono: true },
              { label: '每 token 查表', value: ret.lookup_bytes_per_token ? fmtBytes(ret.lookup_bytes_per_token) : undefined, path: 'arch.retrieval.lookup_bytes_per_token', mono: true },
              { label: '表放置', value: ret.placement, path: 'arch.retrieval.placement' },
              { label: 'MTP 层', value: m.arch?.decoding?.mtp_layers, path: 'arch.decoding', mono: true },
              { label: '投机解码', value: m.arch?.decoding?.speculative
                  // num_tokens 是选填的：MiniMax-M3.1-Flash 的 DSpark 只发了草稿头、
                  // 没有公布每步草稿 token 数。无条件拼 `×${…}` 会在页面上印出
                  // 字面量 undefined —— 数据对、构建过，读者看到的仍然是错的
                  ? [m.arch.decoding.speculative.method, m.arch.decoding.speculative.num_tokens]
                      .filter((x) => x !== undefined && x !== null).join(' ×')
                  : undefined, path: 'arch.decoding' },
            ]}
          />
          {m.arch?.residual?.note && <p class="small muted"><Prose text={m.arch.residual.note} /></p>}
        </div>
      )
    }
  </div>

  {
    m.arch?.vision && (
      <div class="card" style="margin-top:12px">
        <h3 style="margin-top:0">视觉</h3>
        <Facts
          evidence={ev}
          rows={[
            { label: '编码器', value: m.arch.vision.encoder, path: 'arch.vision.encoder' },
            { label: '层 / hidden', value: `${m.arch.vision.layers ?? '—'} / ${m.arch.vision.hidden ?? '—'}`, path: 'arch.vision', mono: true },
            { label: 'patch', value: m.arch.vision.patch_size, path: 'arch.vision', mono: true },
            { label: '空间合并', value: m.arch.vision.spatial_merge_size, path: 'arch.vision', mono: true },
            { label: '最大图像 token', value: m.arch.vision.max_image_tokens, path: 'arch.vision', mono: true },
            { label: '融合方式', value: m.arch.vision.fusion, path: 'arch.vision.fusion' },
          ]}
        />
      </div>
    )
  }

  <h2>精度</h2>
  <div class="card">
    <Facts
      evidence={ev}
      rows={[
        { label: '训练精度', value: m.precision?.training, path: 'precision.training' },
        { label: '发布权重精度', value: m.precision?.weights_release, path: 'precision.weights_release' },
        // 没有厂商口径时这一行以前整条消失，读者看不出本仓查过没有。
        // 合成的说法（未公布 / 不适用）不挂 path —— 证据徽标是给记录里的事实用的，
        // 这一格是本仓的说明，挂上去会变成「厂商官方披露：未公布」
        {
          label: 'KV cache',
          value: kvPrec.text,
          path: kvPrec.declared ? 'precision.kv_cache' : undefined,
        },
        { label: '量化方法', value: q.method, path: 'precision.quantization' },
        { label: '激活量化', value: q.activation_scheme, path: 'precision.quantization' },
        { label: 'block 大小', value: q.weight_block_size, path: 'precision.quantization', mono: true },
        { label: '权重元素格式', value: q.weight_format, path: 'precision.quantization', mono: true },
        { label: 'scale 格式', value: q.scale_format, path: 'precision.quantization', mono: true },
        {
          label: '分子系统精度（主仓实测）',
          // 权重精度与 scale 精度要并排看：FP4 权重配 FP8_E8M0 的 scale，
          // 只看一个会让反量化实现猜错 scale 张量的大小
          value: q.per_subsystem
            ? Object.entries(q.per_subsystem)
                .map(([k, v]) => {
                  const sc = q.per_subsystem_scale?.[k];
                  return `${SUBSYSTEM_LABEL[k] ?? k} ${v}${sc ? ` / ${sc}` : ''}`;
                })
                .join('，')
            : undefined,
          path: 'precision.quantization',
        },
        { label: '实测方式', value: q.subsystem_method, path: 'precision.quantization' },
      ]}
    />
    {q.packing_note && <p class="small muted"><Prose text={q.packing_note} /><Evidence tag="derived" /></p>}
    {/* 发布变体的口径。这个字段原先一处都不渲染 —— 而它存在的理由恰恰是让
        「厂商发过但没进上面那张精度表」的档位在页面上可见：M3 主仓是 BF16，
        精度表照实报 BF16，读者看着像这一代莫名退回不量化，而厂商同时发了 MXFP8。
        不渲染就等于把这个字段当注释写，闸口也查不出来。
        三种说法而不是两种：manifest_taken 与 in_precision_table 是两件事，
        「清单已取、但没进这张表」以前没法表达，只能跟「没取过」共用一句话。 */}
    {
      Object.keys(m.precision?.weights_release_scope ?? {}).length > 0 && (
        <div class="small muted" style="margin-top:10px">
          <div>
            <strong>发布变体的口径</strong>
            <Evidence tag={evidenceFor('precision.weights_release_scope', ev)} />
          </div>
          {Object.entries(m.precision!.weights_release_scope!).map(([prec, sc]: [string, any]) => (
            <p style="margin:4px 0 0">
              <strong>{prec}</strong>
              {sc?.repo ? ` · ${sc.repo}` : ''}
              {sc?.container ? ` · 落盘容器 ${sc.container}` : ''}
              {` · ${
                sc?.in_precision_table
                  ? '已进上面的精度表'
                  : sc?.manifest_taken
                    ? '清单已取，但不在上面的精度表内'
                    : '本仓未取过清单，不在上面的精度表内'
              }`}
              {sc?.note ? <> —— <Prose text={sc.note} /></> : null}
            </p>
          ))}
        </div>
      )
    }
    {/* 厂商另发在独立仓里的官方量化变体，逐仓逐张量实测。
        **为什么单成一段，而不是并进上面那张「分子系统精度」。** 那一行的口径是
        hf.repo 那一份权重 —— 它是 derive.py 识别打包用的承重件，不能换；
        而精度演进页逐格取「厂商官方发布过的最低精度」，取数就来自下面这几条。
        两处给出不同的值是对的，所以必须让读者看见第二份在哪、测自哪个仓。
        **原生发布与事后再量化分开标**：同一张表里不加区分地并列，
        「这一代的权重就是 4 bit」和「这一代另发了一个 4 bit 量化版」看起来一样。 */}
    {
      officialVariants(m).length > 0 && (
        <div style="margin-top:14px">
          <div class="small">
            <strong>另发的官方量化仓（逐仓实测）</strong>
            <Evidence tag={evidenceFor('precision.quantization.official_variants', ev)} />
            <span class="muted"> · 口径与上面那行不同：上面是模型主仓，下面逐条是各自那个仓</span>
          </div>
          {officialVariants(m).map((v) => (
            <div class="card" style="margin-top:8px">
              <div class="small">
                <strong>{v.dtype}</strong>
                <span class="muted"> · {ORIGIN_LABEL[v.origin] ?? v.origin}</span>
                {' · '}<code>{v.repo}</code>
                {/* 同仓不同文件的发布形态：仓名一样，权重不一样。不印文件名的话
                    LTX-2 的 fp8 / fp4 两条会显示成「同一个仓发了两次」 */}
                {v.file && <> · <code>{v.file}</code></>}
                {v.rev && <span class="muted"> @ {v.rev}</span>}
                {/* 整包量化仓 vs 只收了一个组件的主记录：不写明覆盖面，
                    下面那个「与主仓逐位相同」会被读成覆盖了整个仓 */}
                {v.component && (
                  <span class="muted"> · 口径只到 <code>{v.component}</code> 组件（与本记录的清单同口径）</span>
                )}
              </div>
              <Facts
                evidence={ev}
                rows={[
                  {
                    label: '逐子系统精度',
                    value: Object.entries(v.per_subsystem ?? {})
                      .map(([k, d]) => {
                        const sc = v.per_subsystem_scale?.[k];
                        const bk = v.per_subsystem_block?.[k];
                        // 粒度与块是两件事：逐通道的那几份根本没有块，
                        // 只印三元组会让这一格看起来「块没查到」
                        const st = v.per_subsystem_strategy?.[k];
                        const gr = st && st !== 'block' && st !== 'group'
                          ? STRATEGY_LABEL[st] ?? st : undefined;
                        return `${SUBSYSTEM_LABEL[k] ?? k} ${d}`
                          + `${sc ? ` / ${sc}` : ''}${bk ? ` / ${bk}` : ''}`
                          + `${gr ? `（${gr}）` : ''}`;
                      })
                      .join('，'),
                    path: 'precision.quantization.official_variants',
                  },
                  { label: '张量数', value: v.tensor_count ? fmtInt(v.tensor_count) : undefined,
                    path: 'precision.quantization.official_variants', mono: true },
                  // 参数量与主仓逐位相同是**可验证的事实**，不是巧合：同一份权重的两种存法。
                  // 印出来是为了让读者自己和上面「参数量」那节对一眼 —— validate 的
                  // check_variants 守这一条，但闸口绿了不等于读者看过
                  // 差额不能只在散文里说。默认是 0（同一份权重的两种存法），
                  // 非 0 的那几份是真有讲得通的差（GLM-4.6 主仓把草稿块的
                  // embed/head 与主干绑定不落盘，FP8 仓实体化了），
                  // 印出来才看得见「这里不是逐位相同」
                  { label: '参数量（还原打包）',
                    value: v.params_total
                      ? `${fmtInt(v.params_total)}（${v.params_delta
                          ? `比主仓多 ${fmtInt(v.params_delta)}`
                          : '与主仓逐位相同'}）`
                      : undefined,
                    path: 'precision.quantization.official_variants', mono: true },
                  { label: '参数量差额的来由', value: v.params_delta_reason,
                    path: 'precision.quantization.official_variants' },
                  { label: '权重存储',
                    value: v.weight_bytes_total
                      ? `${fmtBytes(v.weight_bytes_total)}（${fmtInt(v.weight_bytes_total)} B）`
                      : undefined,
                    path: 'precision.quantization.official_variants', mono: true },
                  { label: '实测方式', value: v.method,
                    path: 'precision.quantization.official_variants' },
                ]}
              />
              {v.note && <p class="small muted"><Prose text={v.note} /></p>}
            </div>
          ))}
        </div>
      )
    }
  </div>

  {
    m.layers && (
      <>
        <h2>逐层实现</h2>
        <LayerMap L={m.layers} recorded={a.kv_sharing?.measured_per_token} />
      </>
    )
  }

  {/* 注意力架构图：有 components/attention/<id>.astro 就画，没有就整段不出现。
      加一张图只要新建那个文件，不用改这里 —— 六个家族可以各写各的，不碰同一份代码 */}
  <AttentionFigure id={m.id} />

  <h2>推导负载</h2>
  <p class="small muted">
    本节全部由 <code>scripts/derive.py</code> 生成<Evidence tag="derived" />，不手写。
    {d?.generated_at && ` 生成于 ${d.generated_at}。`}
  </p>

  {
    isGen && (gw?.status === 'ok' || gw?.status === 'partial') ? (
      <>
        <div class="grid c3">
          <div class="card stat">
            <div class="label">序列长度</div>
            <div class="value">{Math.round(gw.sequence_tokens ?? gw.latent_tokens).toLocaleString()}</div>
            <div class="sub">
              latent token {Math.round(gw.latent_tokens).toLocaleString()}
              {gw.audio_tokens ? ` + 音频 ${Math.round(gw.audio_tokens).toLocaleString()}` : ''}
              {gw.sequence_tokens_is_lower_bound ? ' · 下界' : ''}
            </div>
          </div>
          <div class="card stat">
            <div class="label">单步 FLOPs</div>
            <div class="value">{fl((gw.flops_per_step?.linear ?? 0) + (gw.flops_per_step?.attention ?? 0))}</div>
            <div class="sub">
              线性 {fl(gw.flops_per_step?.linear)} · 注意力 {fl(gw.flops_per_step?.attention)}
              {gw.flops_per_step?.attention
                ? `（占 ${Math.round(gw.flops_per_step.attention /
                    (gw.flops_per_step.linear + gw.flops_per_step.attention) * 100)}%）`
                : ''}
            </div>
          </div>
          <div class="card stat">
            <div class="label">线性项按什么标度</div>
            {gw.flops_per_step?.linear_terms?.factors?.per_sample !== undefined ? (
              <>
                <div class="value">
                  {fmtCount(gw.flops_per_step.linear_terms.factors.per_video_token)} / token
                </div>
                <div class="sub">
                  逐样本 {fmtCount(gw.flops_per_step.linear_terms.factors.per_sample)}
                  （AdaLN 这类吃条件向量的，每次前向只过一遍）
                  {gw.flops_per_step.linear_terms.factors.per_text_token
                    ? ` · 仅文本 ${fmtCount(gw.flops_per_step.linear_terms.factors.per_text_token)}`
                    : ''}
                  {/* 文本 token 数是线性项的一个因子 —— 不显示就没法逐因子验。
                      没填时 derive 会把线性项标成下界，那条在 notes 里 */}
                  {gw.flops_per_step.linear_terms.factors.text_tokens
                    ? ` × ${gw.flops_per_step.linear_terms.factors.text_tokens} 个文本 token`
                    : ''}
                </div>
              </>
            ) : (
              <>
                <div class="value">未分桶</div>
                {/* 没填 param_scaling 时线性项是上界，这句必须说 ——
                    AdaLN 在新一代生成类里占三分之一上下，一刀切会高 1.6–3 倍 */}
                <div class="sub">
                  线性项按「每个参数过每个 token」算，是<strong>上界</strong>。
                  填 <code>backbone.param_scaling</code> 可以算准
                </div>
              </>
            )}
          </div>
          <div class="card stat">
            <div class="label">端到端 FLOPs</div>
            <div class="value">{gw.flops_end_to_end ? fl(gw.flops_end_to_end) : '—'}</div>
            <div class="sub">
              {gw.end_to_end_terms?.formula ?? '步数或每步前向次数未录，算不出'}
            </div>
          </div>
        </div>

        <div class="grid c2" style="margin-top:14px">
          <div>
            <h3>token 数怎么来的</h3>
            {/* 逐因子列出来，Gate B 才核得动 —— 报一个乘积而不给因子，
                等于要人重做一遍推导 */}
            <p class="small muted" style="margin:0 0 6px"><code>{gw.latent_tokens_terms?.formula}</code></p>
            <table>
              <tbody>
                {Object.entries(gw.latent_tokens_terms?.factors ?? {}).map(([k, v]) => (
                  <tr><td>{k}</td><td class="num">{String(v)}</td></tr>
                ))}
                {gw.latent_tokens_terms?.latent_frames && (
                  <tr><td>latent 帧数</td><td class="num">{gw.latent_tokens_terms.latent_frames}</td></tr>
                )}
              </tbody>
            </table>
          </div>
          <div>
            <h3>有效压缩率</h3>
            <p class="small muted" style="margin:0 0 6px">
              <Prose text={gw.effective_compression?.note ?? ''} />
            </p>
            <table>
              <tbody>
                <tr><td>时间（块内）</td><td class="num">{gw.effective_compression?.temporal}×</td></tr>
                {/* 端到端比值 ≠ 块内卷积比。H3 按 17 帧一块、补 3 帧到 20 再除以 4，
                    于是 243 帧出 72 个 latent 帧，端到端是 3.375 而不是 4 ——
                    而且各档位之间不是常数（3.375 / 3.368 / 3.351）。
                    两个数并排放，省得有人拿其中一个去推另一个 */}
                {gw.latent_tokens_terms?.effective_temporal_ratio
                  && Math.abs(gw.latent_tokens_terms.effective_temporal_ratio
                              - (gw.effective_compression?.temporal ?? 0)) > 1e-6 && (
                  <tr>
                    <td>时间（端到端）</td>
                    <td class="num">{gw.latent_tokens_terms.effective_temporal_ratio.toFixed(3)}×</td>
                  </tr>
                )}
                <tr><td>高</td><td class="num">{gw.effective_compression?.spatial_h}×</td></tr>
                <tr><td>宽</td><td class="num">{gw.effective_compression?.spatial_w}×</td></tr>
              </tbody>
            </table>
            {gw.bucket && (
              <p class="small muted" style="margin-top:8px">
                档位 {gw.bucket.width}×{gw.bucket.height}
                {gw.bucket.frames ? ` × ${gw.bucket.frames} 帧` : ''}
                {gw.bucket.fps ? ` @ ${gw.bucket.fps} fps` : ''}
                {gw.bucket.duration_s ? `（${gw.bucket.duration_s.toFixed(2)} 秒）` : ''}
