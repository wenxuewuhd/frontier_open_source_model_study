          </div>
        </div>
        {/* 多段流水线逐段摊开。端到端是个求和，而各段的 token 数可以差一倍以上
            （超分段分辨率不同，注意力是 O(n²)）—— 只给总数读者无从判断它准不准。
            `tokens_source` 说清这一段是按自己的分辨率算的还是借了主干段的。 */}
        {Array.isArray(gw.end_to_end_terms?.stages) && gw.end_to_end_terms.stages.length > 1 && (
          <div style="margin-top:14px">
            <h3>端到端逐段</h3>
            <table>
              <thead><tr>
                <th>阶段</th><th class="num">步数</th><th class="num">每步前向</th>
                <th class="num">token</th><th class="num">单步 FLOPs</th><th class="num">本段 FLOPs</th>
              </tr></thead>
              <tbody>
                {gw.end_to_end_terms.stages.map((st: any) => (
                  <tr>
                    <td>{st.name}{st.tokens_source === 'default_bucket'
                      ? <span class="muted small">（借主干段的 token 数）</span> : ''}</td>
                    <td class="num">{st.steps}</td>
                    <td class="num">{st.forwards_per_step}</td>
                    <td class="num">{Math.round(st.tokens).toLocaleString()}</td>
                    <td class="num">{fl(st.flops_per_step)}</td>
                    <td class="num">{fl(st.flops)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {/* derive 自己写的免责声明。它一直在产物里，而页面只显示结果和求和公式 ——
            「这是粗估」这句话不渲染，等于没写 */}
        {gw.end_to_end_terms?.note && (
          <p class="small muted" style="margin-top:8px"><Prose text={gw.end_to_end_terms.note} /></p>
        )}
        {Array.isArray(gw.end_to_end_terms?.stages_skipped) && gw.end_to_end_terms.stages_skipped.length > 0 && (
          <p class="small muted" style="margin-top:6px">
            未计入端到端（缺步数或每步前向次数）：{gw.end_to_end_terms.stages_skipped.join('、')}
          </p>
        )}
        {/* excluded 是数组 —— 端到端那个数**不含**这几项，不写出来读者会当成全量 */}
        {Array.isArray(gw.excluded) && gw.excluded.length > 0 && (
          <p class="small muted" style="margin-top:10px">
            端到端不含：{gw.excluded.join('；')}
          </p>
        )}
        {Array.isArray(gw.notes) && gw.notes.map((n: string) => (
          <p class="small muted" style="margin-top:6px"><Prose text={n} /></p>
        ))}
      </>
    ) : isGen ? (
      <p class="small muted">
        {/* 别替它编理由：derive 给了 why 就印 why，没给就说清是「没算出来」，
            而不是「记录里没有 generation 块」—— 后者是个具体的、可能错的断言 */}
        生成负载没算出来{gw?.why ? `：${gw.why}` : `（derive 返回 status=${gw?.status ?? '无'}，未给原因）`}
      </p>
    ) : kv?.status && kv.status !== 'unknown' ? (
      <>
        <div class="grid c3">
          <div class="card stat">
            <div class="label">随上下文增长</div>
            <div class="value">{kv.per_token_bytes?.toLocaleString()} B</div>
            <div class="sub">
              每 token · full attention {kv.full_attention_layers} 层{kvBasis && ` · ${kvBasis}`}
            </div>
          </div>
          <div class="card stat">
            <div class="label">每序列固定</div>
            <div class="value">{fmtBytes(kv.per_sequence_bytes)}</div>
            <div class="sub">
              {kv.linear_attention_layers
                ? `线性注意力 ${kv.linear_attention_layers} 层的递归状态`
                : kv.components?.local_window
                  ? '滑窗局部 KV'
                  : '无线性层'}
              {kv.per_sequence_bytes > 0 && kvBasis && ` · ${kvBasis}`}
            </div>
          </div>
          <div class="card stat">
            <div class="label">激活 · 带宽口径</div>
            <div class="value">{act?.status === 'ok' ? fmtCount(act.total) : '—'}</div>
            <div class="sub">
              {act?.total_with_embed ? `可比官方口径 ${fmtCount(act.total_with_embed)}` : ''}
            </div>
          </div>
        </div>

        <div class="grid c2" style="margin-top:14px">
          <div>
            <h3>注意力显存分量</h3>
            <table>
              <thead><tr><th>分量</th><th class="num">层数</th><th class="num">贡献{kvBasis && `（${kvBasis}）`}</th></tr></thead>
              <tbody>
                {Object.entries(kv.components ?? {}).map(([name, c]: [string, any]) => (
                  <tr>
                    <td>{name}</td>
                    <td class="num">{c.layers ?? '—'}</td>
                    <td class="num">
                      {c.bytes_per_token
                        ? `${c.bytes_per_token.toLocaleString()} B/token`
                        : `${fmtBytes(c.bytes_per_sequence)}/序列`}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {(kv.notes ?? []).length > 0 && (
              <div class="note" style="margin-top:10px">
                <ul class="plain" style="margin:0">
                  {kv.notes.map((n: string) => <li><Prose text={n} /></li>)}
                </ul>
              </div>
            )}
          </div>
          <div>
            <h3>KV 容量</h3>
            <table>
              <thead><tr><th class="num">上下文</th><th class="num">容量{kvBasis && `（${kvBasis}）`}</th></tr></thead>
              <tbody>
                {capacity.map(([L, v]) => (
                  <tr>
                    <td class="num">{fmtInt(Number(L))}</td>
                    <td class="num">{fmtBytes(v)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <table style="margin-top:12px">
              <tbody>
                {d?.flops?.linear_per_token && (
                  <tr>
                    <td>线性 FLOPs / token</td>
                    <td class="num">{fmtCount(d.flops.linear_per_token)}</td>
                  </tr>
