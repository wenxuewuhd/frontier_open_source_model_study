  {
    Array.isArray(m.performance) && m.performance.length > 0 && (
      <>
        <h2>厂商公布的实测性能</h2>
        <p class="small muted">
          本仓不自测。这里只收厂商材料里<strong>说清了配置</strong>的那些 ——
          硬件、分辨率、帧数、步数、开没开工程加速。
        </p>
        <div class="tablewrap">
        <table>
          <thead><tr>
            <th>配置</th><th>硬件</th><th class="num">每步</th><th class="num">端到端</th>
            <th class="num">显存峰值</th><th>对照</th><th>出处</th>
          </tr></thead>
          <tbody>
            {m.performance.map((pf: any) => (
              <tr>
                <td>
                  {[pf.resolution, pf.frames && `${pf.frames} 帧`, pf.steps && `${pf.steps} 步`]
                    .filter(Boolean).join(' · ')}
                  {pf.engine && <div class="small muted">{pf.engine}</div>}
                </td>
                <td>{pf.hardware}{pf.device_count ? ` ×${pf.device_count}` : ''}</td>
                <td class="num">{pf.seconds_per_step ? `${pf.seconds_per_step} s` : '—'}</td>
                <td class="num">{pf.seconds_end_to_end ? `${pf.seconds_end_to_end} s` : '—'}</td>
                <td class="num">{pf.peak_memory_bytes ? fmtBytes(pf.peak_memory_bytes) : '—'}</td>
                <td>
                  {pf.baseline?.what
                    ? <>
                        {pf.baseline.what}
                        <div class="small muted">
                          {pf.baseline.seconds_per_step ? `${pf.baseline.seconds_per_step} s/步` : ''}
                          {pf.baseline.seconds_end_to_end ? `${pf.baseline.seconds_end_to_end} s` : ''}
                          {pf.speedup ? ` → ${pf.speedup}×` : ''}
                        </div>
                      </>
                    : <span class="muted">无</span>}
                </td>
                <td class="small">
                  {pf.source?.ref?.locator ?? pf.source?.type}
                  <Evidence tag={pf.source?.type === 'official' ? 'official' : 'judgement'} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </>
    )
  }

  <h2>交叉核对</h2>
  <p class="small muted">
    config 公式与权重清单两条路都能算的量在这里核对。这是人工复核的主要入口。
  </p>
  {/* **两路还剩几路，必须在表的上面说。** 下面那张表只列「两路都能算的量」，
      所以少一路时它会安静地变短 —— 看起来和「核对过、都一致」长得一样。
      这个事实 derive 一直知道（inputs.config_present / shapes_present），
      但此前埋在产物里没人读。 */}
  {d?.gate_b && d.gate_b.paths < 2 && (
    <div class="warn" style="margin-bottom:12px">
      <strong>这份记录的 Gate B 只剩 {d.gate_b.paths} 路</strong>
      （{d.gate_b.config ? 'config 有' : 'config 无'} ·
       {d.gate_b.manifest ? '权重清单有' : d.gate_b.manifest_incomplete ? '权重清单不完整' : '权重清单无'}）。
      {d.gate_b.why && <> <Prose text={d.gate_b.why} /></>}
      <br />
      <span class="small">少一路不等于记录不可信，等于<strong>这一类断言没有第二个来源可对</strong>。
      下表会相应变短。</span>
    </div>
  )}
  <table>
    <thead><tr><th>条目</th><th>结论</th><th>说明</th></tr></thead>
    <tbody>
      {
        rec.map((r) => (
          <tr>
            <td>{r.item}</td>
            <td>
              {r.status === 'MISMATCH' ? <strong>不一致</strong> : r.status === 'skip' ? <span class="muted">跳过</span> : '一致'}
              {r.delta_pct !== undefined && <span class="num"> {r.delta_pct > 0 ? '+' : ''}{r.delta_pct}%</span>}
            </td>
            <td class="small muted">
              {r.why ??
                Object.entries(r)
                  .filter(([k]) => !['item', 'status', 'why', 'delta_pct'].includes(k))
                  .map(([k, v]) => `${k}=${typeof v === 'number' ? fmtCount(v) : v}`)
                  .join('  ')}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    (m.platforms ?? []).length > 0 && (
      <>
        <h2>平台支持</h2>
        <table>
          <thead>
            <tr><th>引擎</th><th>硬件</th><th>精度</th><th>状态</th><th>限定</th></tr>
          </thead>
          <tbody>
            {m.platforms!.map((p: any) => (
              <tr>
                <td>{p.engine}{p.engine_version ? ` ${p.engine_version}` : ''}</td>
                <td>{p.hardware}</td>
                <td class="num">{p.precision ?? '—'}</td>
                <td>{p.status}</td>
                <td class="small muted"><Prose text={p.caveat ?? ''} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  {
    (m.bottlenecks ?? []).length > 0 && (
      <>
        <h2>瓶颈分析</h2>
        <div class="grid">
          {m.bottlenecks!.map((b: any) => (
            <div class="card">
              <div class="small muted" style="margin-bottom:4px">
                {b.dimension}
                <Evidence tag={b.evidence ?? 'judgement'} />
              </div>
              <div><Prose text={b.finding} /></div>
              {b.quantified && <div class="small num" style="margin-top:6px"><Prose text={b.quantified} /></div>}
              {/* finding / quantified / fix 三个都是散文字段，三个都要走 Prose。
                  这里原先是裸 {b.fix}，于是反引号和 ** 在产物上照原样印出来 ——
                  同一个块里两个解析一个不解析，谁也不会想到去查第三个 */}
              {b.fix && <div class="small muted" style="margin-top:6px"><strong>可修</strong>：<Prose text={b.fix} /></div>}
            </div>
          ))}
        </div>
      </>
    )
  }

  {
    m.ops_table && (
      <>
        <h2>算子表</h2>
        <div class="note">
          本模型的 decode 算子表位于 <code>{m.ops_table.ref}</code>，
          归属 <strong>{m.ops_table.visibility === 'internal' ? '内部' : '公开'}</strong>。
          {m.ops_table.visibility === 'internal' &&
            '公开站不含表体；内部构建（叠加 overlay）可浏览并下载 xlsx。'}
        </div>
      </>
    )
  }

  {
    (m.infra_signals ?? []).length > 0 && (
      <>
        <h2>Infra 信号</h2>
        <div class="grid">
          {m.infra_signals!.map((sg: any) => (
            <div class="card">
              <div class="small muted" style="margin-bottom:4px">
                {HORIZON_LABEL[sg.horizon] ?? sg.horizon}
                {sg.axis && ` · ${sg.axis}`}
                <Evidence tag={sg.evidence} />
              </div>
              <div><Prose text={sg.text} /></div>
            </div>
          ))}
        </div>
      </>
    )
  }

  <div class="grid c2" style="margin-top:18px">
    {
      (m.open_questions ?? []).length > 0 && (
        <div>
          <h2 style="margin-top:0">开放问题</h2>
          <ul class="plain small">
            {m.open_questions!.map((o: string) => <li><Prose text={o} /></li>)}
          </ul>
        </div>
      )
    }
    {
      (m.sources ?? []).length > 0 && (
        <div>
          <h2 style="margin-top:0">来源</h2>
          <ul class="plain small">
            {m.sources!.map((src: any) => (
              <li>
                {src.url ? <a href={src.url}>{src.kind}</a> : src.kind}
                {src.locator && <span class="muted"> · {src.locator}</span>}
                {src.note && <div class="muted"><Prose text={src.note} /></div>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <h2>核查</h2>
  {
    rv.reviewed ? (
      <>
        <p class="small muted">
          {(m as any).reviewed.date} 核查 · 覆盖
          {((m as any).reviewed.scope ?? []).join('、') || '未说明范围'} ·
          共 {rv.total} 条发现，已改 {rv.corrected}，未解决 {rv.open}。
          <br />
          方法：<Prose text={(m as any).reviewed.method} />
        </p>
        {((m as any).review ?? []).length > 0 && (
          <table>
            <thead>
              <tr>
                <th>编号</th><th>字段</th><th>类型</th><th>发现</th><th>结论</th>
              </tr>
            </thead>
            <tbody>
              {(m as any).review.map((f: any) => (
                /* 未解决的发现不能和已改的长得一样 —— 它是「这里现在就不可靠」，
                   不是「这里曾经错过」。底色标出来，让人引用前先看见。 */
                <tr style={f.resolution === 'open' ? 'background: var(--warn-bg)' : undefined}>
                  <td class="num">{f.id}</td>
                  <td class="small num">{f.field}</td>
                  <td class="small">{SEVERITY_LABEL[f.severity] ?? f.severity}</td>
                  <td class="small">
                    {f.claim && <div class="muted">原先：<Prose text={f.claim} /></div>}
                    <div><Prose text={f.finding} /></div>
                    {f.changed_to && <div class="muted">改为：<Prose text={f.changed_to} /></div>}
                  </td>
                  <td class="small">
                    <strong>{RESOLUTION_LABEL[f.resolution] ?? f.resolution}</strong>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </>
    ) : (
      <div class="note">
        这份记录<strong>还没有经过核查</strong>。数字通过了 schema 校验与交叉核对，
        但判断类内容没有被独立质疑过，引用前请自行复核。
      </div>
    )
  }

  {m.notes && <><h2>备注</h2><p class="small"><Prose text={m.notes} /></p></>}

  <p class="small muted" style="margin-top:28px">
    <a href={url('/models/')}>← 返回模型列表</a>
  </p>
</Base>
