---
import { url, BUILD_IS_INTERNAL } from '../lib/data';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;

const nav = [
  { href: '/', label: '总览' },
  { href: '/families/', label: '家族演进' },
  { href: '/attention/', label: '注意力演进' },
  { href: '/models/', label: '模型' },
  { href: '/platforms/', label: '平台矩阵' },
  { href: '/about/', label: '口径说明' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 前沿开源大模型演进跟踪</title>
    <meta
      name="description"
      content="从 infra 视角跟踪主流开源大模型与新型范式的演进：架构、精度、平台支持与瓶颈分析。"
    />
    <style is:global>
      :root {
        --bg: #fbfbfa;
        --surface: #ffffff;
        --line: #e4e2dd;
        --ink: #1a1a18;
        --ink-2: #5c5a54;
        --ink-3: #8b8880;
        --accent: #1f6f5c;
        --official: #1f6f5c;
        --derived: #2b5f8f;
        --judgement: #8a5a1b;
        --unknown: #8b8880;
        --warn-bg: #fdf6e8;
        --warn-line: #e6cfa0;
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #15161a;
          --surface: #1c1e23;
          --line: #2e3138;
          --ink: #e9e8e4;
          --ink-2: #a7a59e;
          --ink-3: #74726c;
          --accent: #6ac4a7;
          --official: #6ac4a7;
          --derived: #79b2e0;
          --judgement: #d9a861;
          --unknown: #74726c;
          --warn-bg: #2a241a;
          --warn-line: #4d4228;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: system-ui, -apple-system, 'Segoe UI', 'PingFang SC',
          'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        font-size: 15px;
        line-height: 1.65;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }

      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }

      header.site {
        border-bottom: 1px solid var(--line);
        background: var(--surface);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.site .wrap {
        display: flex;
        align-items: baseline;
        gap: 20px;
        flex-wrap: wrap;
        padding-top: 12px;
        padding-bottom: 12px;
      }
      .brand { font-weight: 650; letter-spacing: -0.01em; color: var(--ink); }
      nav.site { display: flex; gap: 16px; flex-wrap: wrap; }
      nav.site a { color: var(--ink-2); font-size: 14px; }
      nav.site a[aria-current='page'] { color: var(--ink); font-weight: 600; }
      .internal-flag {
        margin-left: auto;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: 99px;
        background: var(--warn-bg);
        border: 1px solid var(--warn-line);
        color: var(--judgement);
      }

      main { padding: 28px 0 64px; }
      h1 { font-size: 26px; margin: 0 0 6px; letter-spacing: -0.015em; }
      h2 {
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--ink-3);
        margin: 36px 0 12px;
        font-weight: 650;
      }
      h3 { font-size: 15px; margin: 20px 0 8px; }
      .lead { color: var(--ink-2); margin: 0 0 4px; max-width: 70ch; }

      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td {
        text-align: left;
        padding: 7px 10px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      th { color: var(--ink-3); font-weight: 600; font-size: 12.5px; }
      td.num, th.num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
      tbody tr:hover { background: color-mix(in oklab, var(--surface) 70%, var(--bg)); }

      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 14px 16px;
      }
      .grid { display: grid; gap: 12px; }
      .grid.c2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .grid.c3 { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }

      .kv { display: grid; grid-template-columns: minmax(130px, auto) 1fr; gap: 3px 14px; font-size: 14px; }
      .kv dt { color: var(--ink-3); }
      .kv dd { margin: 0; }

      .stat .label { font-size: 12px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.05em; }
      .stat .value { font-family: var(--mono); font-size: 20px; font-variant-numeric: tabular-nums; }
      .stat .sub { font-size: 12.5px; color: var(--ink-3); }

      .note {
        background: var(--warn-bg);
        border: 1px solid var(--warn-line);
        border-radius: 6px;
        padding: 10px 12px;
        font-size: 13.5px;
        color: var(--ink-2);
      }
      .muted { color: var(--ink-3); }
      .small { font-size: 13px; }

      /* 宽表（版本横向排开）单独滚动，不要把整页撑出横向滚动条 */
      .scroll-x { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
      .scroll-x table { font-size: 13px; }
      .scroll-x th, .scroll-x td { white-space: nowrap; }
      .scroll-x th:first-child, .scroll-x td:first-child {
        position: sticky;
        left: 0;
        background: var(--surface);
        border-right: 1px solid var(--line);
      }
      .dot { color: var(--accent); font-weight: 700; }
      .dash { color: var(--ink-3); }
      /* 主线与支线在表头上要分得开：支线是同代的平行版本或权重刷新 */
      th.side, td.side { background: color-mix(in oklab, var(--warn-bg) 45%, var(--surface)); }
      .track-mark { font-size: 10px; color: var(--ink-3); vertical-align: super; margin-left: 2px; }
      ul.plain { padding-left: 18px; margin: 6px 0; }
      ul.plain li { margin: 4px 0; }

      footer.site {
        border-top: 1px solid var(--line);
        color: var(--ink-3);
        font-size: 13px;
        padding: 18px 0 40px;
      }
      @media (max-width: 640px) {
        h1 { font-size: 22px; }
        .kv { grid-template-columns: 1fr; gap: 0 0; }
        .kv dt { margin-top: 8px; }
        table { font-size: 13px; }
        th, td { padding: 6px 7px; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={url('/')}>前沿开源大模型演进跟踪</a>
        <nav class="site">
          {
            nav.map((n) => {
              const href = url(n.href);
              const active = here === href.replace(/\/$/, '');
              return <a href={href} aria-current={active ? 'page' : undefined}>{n.label}</a>;
            })
          }
        </nav>
        {BUILD_IS_INTERNAL && <span class="internal-flag">内部构建 · 含 overlay 数据</span>}
      </div>
    </header>

    <main>
      <div class="wrap">
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="wrap">
        数据与分析分开存放，页面上的每个手写数字都带证据口径标注。
        推导值由 <code>scripts/derive.py</code> 生成，不手写。
        <a href={url('/about/')}>口径说明</a>
      </div>
    </footer>
  </body>
</html>
